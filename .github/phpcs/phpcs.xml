<?xml version="1.0"?>
<ruleset name="Sahaj Atlas">
	<description>Security sniffs and PHP-version compatibility. Not the full WordPress standard.</description>

	<!--
		⚠ Deliberately narrow. The full WordPress standard is a style guide (Yoda conditions, file
		names, doc blocks), and adopting it means reformatting the plugin for no defect found. What
		this repo needs checked is what a volunteer's site cannot recover from: output that is not
		escaped, input that is not sanitised, a request that skips a nonce, a SQL string that is not
		prepared. The second half is PHP: the declared floor is 7.4, and the CI lane on a current
		PHP only sees the code a test happens to run.

		Run it from the repository root:
		  composer install -d .github/phpcs
		  .github/phpcs/vendor/bin/phpcs --standard=.github/phpcs/phpcs.xml
	-->

	<file>.</file>
	<exclude-pattern>*/.git/*</exclude-pattern>
	<exclude-pattern>*/.claude/*</exclude-pattern>
	<exclude-pattern>*/.github/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/build/*</exclude-pattern>
	<!-- Third-party, and the plugin's tests are not shipped code. -->
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/tests/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="basepath" value="."/>
	<arg name="parallel" value="8"/>
	<arg value="s"/>

	<!-- The declared floor is 7.4; nothing here raises it. -->
	<config name="testVersion" value="7.4-"/>
	<config name="minimum_wp_version" value="6.7"/>

	<rule ref="PHPCompatibilityWP"/>

	<rule ref="WordPress.Security"/>
	<rule ref="WordPress.DB.PreparedSQL"/>
	<rule ref="WordPress.DB.PreparedSQLPlaceholders"/>
</ruleset>
