# Local WordPress test environments
.wp-env.override.json
wordpress/
wp-content/

# Playwright / Playground
node_modules/
test-results/
playwright-report/
.playground/

# Build output — the release zip is built in CI, never committed
build/
*.zip

# Translation output. `.github/scripts/i18n.sh` builds the template, the .mo and the .json files
# into the zip at package time, so none of them belongs in a commit. A `.po` a translator writes is
# the one file here that does.
languages/*.pot
languages/*.mo
languages/*.json

# Editors and OS
.DS_Store
.idea/
.vscode/
*.swp

# Never commit a real key
.env
.env.local
.env.claude.local

# Screenshots the browser lane writes, one per theme and viewport
tests/screenshots/

# Captured output from the WordPress test run
.test-output.txt

# Outbound requests tests/no-network.php refused during a run
.test-network.txt

# Per-user Claude config (the other three repos ignore this too)
.claude/settings.local.json

# Worktrees from /implement-issue — a second checkout of this repo, never source
.claude/worktrees/
